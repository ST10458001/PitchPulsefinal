<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="@string/settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/notifications"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/goals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Goals" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cards" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/fullTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Half-time and full-time" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/predictionAlerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prediction results" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/language"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <RadioGroup
            android:id="@+id/languages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/langEn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lang_en" />

            <RadioButton
                android:id="@+id/langAf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lang_af" />

            <RadioButton
                android:id="@+id/langZu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lang_zu" />
        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/testAlert"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/test_alert" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/theme"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <RadioGroup
            android:id="@+id/themes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/themeCharcoal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Charcoal" />

            <RadioButton
                android:id="@+id/themeIvory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ivory (15 Pulse Points)" />
        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearCache"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Clear offline cache" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pulsePro"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Pulse Pro — remove the banner" />
    </LinearLayout>
</ScrollView>
